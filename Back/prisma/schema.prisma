// Schema Prisma - A Casa do Salgado
// Espelha o banco criado pelo script db/init/01_schema.sql (PostgreSQL).
// A URL de conexão fica no prisma7.config.ts (variável DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- ENUMS ----------

enum CargoUsuario {
  GESTOR
  FUNCIONARIO

  @@map("cargo_usuario")
}

enum UnidadeMedida {
  KG
  G
  L
  ML
  UN

  @@map("unidade_medida")
}

// ---------- MODELS ----------

model Usuario {
  id        Int          @id @default(autoincrement())
  nome      String       @db.VarChar(50)
  cargo     CargoUsuario
  senha     String       @db.VarChar(100) // hash, nunca texto puro
  criadoEm  DateTime     @default(now()) @map("criado_em") @db.Timestamp(6)
  ativo     Boolean      @default(true)

  historicoCustos HistoricoCustoInsumo[]

  @@map("usuario")
}

model Ingrediente {
  id            Int           @id @default(autoincrement())
  nome          String        @unique @db.VarChar(50)
  unidade       UnidadeMedida
  custoUnitario Decimal       @map("custo_unitario") @db.Decimal(10, 4) // custo por 1 unidade de medida
  atualizadoEm  DateTime      @default(now()) @updatedAt @map("atualizado_em") @db.Timestamp(6)

  produtos        Produto[]
  historicoCustos HistoricoCustoInsumo[]

  @@map("ingredientes")
}

model Produto {
  id            Int          @id @default(autoincrement())
  nome          String       @db.VarChar(50)
  ingredienteId Int?         @map("ingredientes_id")
  precoVenda    Decimal?     @map("preco_venda") @db.Decimal(10, 2) // preço final aprovado (sugerido ou ajustado)
  ativo         Boolean      @default(true)
  atualizadoEm  DateTime     @default(now()) @updatedAt @map("atualizado_em") @db.Timestamp(6)

  ingrediente Ingrediente? @relation(fields: [ingredienteId], references: [id])

  @@index([ingredienteId], map: "idx_produtos_ingrediente")
  @@map("produtos")
}

model CustoFixo {
  id           Int      @id @default(autoincrement())
  nome         String   @unique @db.VarChar(50) // ex.: Aluguel, Energia, Gás, Salários
  valorMensal  Decimal  @map("valor_mensal") @db.Decimal(10, 2)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamp(6)

  @@map("custo_fixo")
}

model HistoricoCustoInsumo {
  id            Int      @id @default(autoincrement())
  insumoId      Int      @map("insumo_id") // aponta para ingredientes.id
  custoAnterior Decimal? @map("custo_anterior") @db.Decimal(10, 4)
  custoNovo     Decimal  @map("custo_novo") @db.Decimal(10, 4)
  usuarioId     Int      @map("usuario_id")
  alteradoEm    DateTime @default(now()) @map("alterado_em") @db.Timestamp(6)

  ingrediente Ingrediente @relation(fields: [insumoId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])

  @@index([insumoId, alteradoEm(sort: Desc)], map: "idx_hist_custo_insumo")
  @@map("historico_custo_insumo")
}
