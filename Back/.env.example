# Copie para .env e troque COLE_AQUI_A_SENHA pela mesma senha do .env da raiz.
DATABASE_URL="postgresql://salgado:COLE_AQUI_A_SENHA@localhost:5433/casa_do_salgado?schema=public"
PORT=3000
# Endereços do front-end que podem chamar a API, separados por vírgula. Vazio = aceita qualquer origem (só em desenvolvimento).
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
