# Copie para .env (copy .env.example .env) e troque só a senha e o JWT_SECRET.
POSTGRES_DB=casa_do_salgado
POSTGRES_USER=salgado
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
DB_PORT=5433
JWT_SECRET=TROQUE_POR_UM_TEXTO_LONGO_E_ALEATORIO
JWT_EXPIRES_IN=8h
# Porta da API na sua máquina (http://localhost:3000) e endereços do front que podem chamá-la.
API_PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
WEB_PORT=8080
